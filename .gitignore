# ============================================
# CardioSense .gitignore
# ============================================

# macOS
.DS_Store
Thumbs.db

# Python (ML layer + signal pipeline)
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/

# Runtime data files (regenerated each demo run)
**/latest_result.json
**/mode.txt
**/shared/input.json
**/shared/prediction.json
**/shared/prediction.tmp.json

# Logs
logs/
*.log

# Large datasets
raw/
data/
**/MIT-BIH-*/

# IDE
.vscode/
.idea/

# Build artifacts
build/
DerivedData/

# Xcode user state
xcuserdata/

# Backup files
*.bak

# Local Claude Code session state
.claude/

# ML model weights (commit metrics, not weights)
artifacts/*.pt

# Xcode build artifacts (from Swift template)
*.hmap
*.ipa
*.dSYM
*.dSYM.zip
.build/

# Xcode playgrounds
timeline.xctimeline
playground.xcworkspace
